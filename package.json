    "cheerio": "^1.2.0",
    "framer-motion": "^12.38.0",
    "next": "16.2.2",
    "next-auth": "^5.0.0-beta.30",
    "p-limit": "^7.3.0",
    "p-retry": "^8.0.0",
    "pg": "^8.20.0",
    "playwright": "^1.55.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
